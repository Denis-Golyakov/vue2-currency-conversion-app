{
  "extends": "@vue/tsconfig/tsconfig.web.json",
  "include": [
    "./**/*",
    "../support/**/*"
  ],
  "compilerOptions": {
    "isolatedModules": false,
    "target": "es5",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": true,
    "lib": [
      "es5",
      "dom"
    ],
    "types": [
      "cypress"
    ]
  }
}